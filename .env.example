# open-design-system-bench environment — copy to `.env` (gitignored) and fill in what you use.
# The CLI loads this file automatically at startup; variables already set in
# your shell take precedence over values here.

# ── Bring your own Anthropic key (claude CLI bills this key instead of your
#    subscription window; no other change needed) ─────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...

# ── Route the full agentic benchmark through the Nexos gateway ───────────────
#    (byte-for-byte Anthropic /v1/messages passthrough; both vars required)
# ANTHROPIC_BASE_URL=https://api.nexos.ai
# ANTHROPIC_API_KEY=nexos-...

# ── Provider keys for qualified models ("nexos:<model>", "openai:<model>")
#    and --judge-provider ───────────────────────────────────────────────────
# NEXOS_API_KEY=nexos-...
# OPENAI_API_KEY=sk-...

# ── Design system repo location override(s) ───────────────────────────────────
#    Each system in systems.config.json declares its own `rootEnv` var name;
#    the root templates ships one placeholder system whose rootEnv is:
# OPEN_DESIGN_SYSTEM_BENCH_MY_SYSTEM_DIR=/path/to/your-design-system-repo

#    The Aurora example (examples/aurora/systems.config.json) uses these:
# AGENT_EVALS_REACTKIT_DIR=/path/to/aurora-reactkit
# AGENT_EVALS_APPKIT_DIR=/path/to/auroraappkit-component-storybook
