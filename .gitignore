node_modules/
runs/
.DS_Store
fixtures/*/node_modules/
fixtures/*/package-lock.json

# Per-system prepared workspaces for 'npm' consume-mode systems (see
# prepareTemplate's npm branch in src/run/fixture.ts) — built by npm install,
# disposable, never committed.
fixtures/.prepared/
*.log
.npm-cache/
.env

# Generated by `extract` for the root systems.config.json — the Aurora
# example ships its catalogs/tokens as committed snapshots instead, under
# examples/aurora/data/{catalogs,tokens}/.
/catalogs/
/tokens/

# Cloned OSS reference-system repos (P2 reference runs) — reproducible via
# `git clone`, pointed at by examples/oss/*.config.json, never committed.
examples/oss/repos/

# Not shipped to the public repo.
#
# examples/       both the Aurora example and the OSS reference systems. The OSS
#                 side carries third-party design-system names; the Aurora side
#                 carries Nord-internal catalogs and machine-local paths.
# marketing-docs/ pre-approval launch material (blog post, case study, one-pager,
#                 social drafts), pending the P3 legal and trademark review.
#
# NOTE: the tracked tree is clean of these names apart from the Nexos gateway
# example in .env.example (a public endpoint, kept deliberately). Sweep with
# `git grep -i` before re-adding anything from these ignored directories.
examples/
marketing-docs/

# Internal planning and provenance. Not part of the shareable harness.
ROADMAP.md
product.md
INTERNAL.md
# One organization's model/pricing catalog, not a generic mechanism yet.
nexos-models.json

# Aurora-specific source-alias fixture templates. Kept locally so the internal
# example still runs; the shipped harness uses the generic fixtures/source-app,
# which fills __COMPONENTS_PKG__ / __SYSTEM_ROOT__ from each system's config.
fixtures/reactkit-app/
fixtures/appkit-app/

# Local Claude Code settings (the checked-in skill under .claude/skills/ is intentional)
.claude/settings.local.json
